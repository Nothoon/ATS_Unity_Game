  m_Name: DmitriVolkov
  m_EditorClassIdentifier: Assembly-CSharp::ResumeData
  applicantName: Dmitri Volkov
  body: '<b>DMITRI VOLKOV</b>

    Applying for: Head of Cybersecurity


    <b>CURRENT
    EMPLOYER</b>

    {current}


    <b>EXPERIENCE</b>

    {title}


    <b>HOBBIES</b>

    {hobby}


    <b>OTHER</b>

    {not_spy}


    <b>REFERENCES</b>

    {ref}'
  claims:
  - id: current
    text: "Competitor Corp\u2122 (leaving soon, probably)"
    isSuspicious: 1
    category: 0
    designerNote: Current competitor employee breaks rule 6.
    suspiciousQuestion:
      question: You currently work for Competitor Corp?
      answer: Yes, but I am leaving the moment I get your {c_files}. And I {c_hate}
        them.
      demeanor: 2
      phrases:
      - id: c_files
        text: "files\u2014 your JOB"
        isContradiction: 1
        callOutResponse: The JOB. I said job. The moment I get your job. Files is
          just... how I say job.
        callOutDemeanor: 3
      - id: c_hate
        text: hate
        isContradiction: 0
        callOutResponse: So much hate. Look at my face. This is my hate face.
        callOutDemeanor: 0
    goodQuestion:
      question: Competitor Corp experience could be useful.
      answer: Extremely useful. I know all their secrets. And soon, all of yours.
        Because I will work here. Normally.
      demeanor: 5
      phrases: []
  - id: title
    text: Head of Corporate Espionage Prevention
    isSuspicious: 0
    category: 2
    designerNote: 
    suspiciousQuestion:
      question: What does 'Espionage Prevention' involve?
      answer: Preventing spies. I know exactly how spies think. {s_reason}.
      demeanor: 2
      phrases:
      - id: s_reason
        text: For no reason
        isContradiction: 1
        callOutResponse: ...Because I read many books. Spy books. Not spy manuals.
          Different thing.
        callOutDemeanor: 3
    goodQuestion:
      question: Espionage prevention is exactly what we need.
      answer: Yes. I will prevent all espionage. Except mine. I mean except none.
        I prevent all of it.
      demeanor: 2
      phrases: []
  - id: hobby
    text: Photography (server rooms, filing cabinets, passwords)
    isSuspicious: 1
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: You photograph... server rooms and passwords?
      answer: It is {h_art}. The way the light hits a password on a sticky note.
        Beautiful.
      demeanor: 4
      phrases:
      - id: h_art
        text: art
        isContradiction: 0
        callOutResponse: You wouldn't understand. It is very modern.
        callOutDemeanor: 4
    goodQuestion:
      question: Photography is a nice hobby.
      answer: Yes. May I photograph your office? For art. Just the computers. And
        the filing cabinet. Hold that drawer open.
      demeanor: 5
      phrases: []
  - id: not_spy
    text: NOT A SPY
    isSuspicious: 1
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: Why does your resume say 'NOT A SPY'?
      answer: So there is {n_confusion}. Many people ask. It saves time.
      demeanor: 1
      phrases:
      - id: n_confusion
        text: no confusion
        isContradiction: 0
        callOutResponse: If I was a spy, would I write 'not a spy'? No. A spy would
          write 'spy'. Checkmate.
        callOutDemeanor: 1
    goodQuestion:
      question: Good to know you're not a spy.
      answer: Thank you. I am glad that is settled. Please do not {n_shoe}.
      demeanor: 2
      phrases:
      - id: n_shoe
        text: check my shoe
        isContradiction: 1
        callOutResponse: There is nothing in my shoe. Except a tiny camera. For my
          art! For my photography art!
        callOutDemeanor: 3
  - id: ref
    text: Boris, Competitor Corp ('Department of Getting Files')
    isSuspicious: 1
    category: 5
    designerNote: 
    suspiciousQuestion:
      question: What is the 'Department of Getting Files'?
      answer: It is HR. We call it that because HR handles {f_files}.
      demeanor: 2
      phrases:
      - id: f_files
        text: your files. I mean OUR files
        isContradiction: 1
        callOutResponse: THEIR files. Competitor Corp's own files. Which I do not
          have. Of yours. Next question.
        callOutDemeanor: 3
    goodQuestion:
      question: Boris can speak to your work?
      answer: Boris will say I am excellent at getting things. Jobs. Getting jobs.
      demeanor: 5
      phrases: []
  referenceLetter: 'To whom this may concern,


