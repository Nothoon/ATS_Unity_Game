    goodQuestion:
      question: Can Gary vouch for your work?
      answer: Gary is great. Gary is also {g_inside} at home.
      demeanor: 2
      phrases:
      - id: g_inside
        text: "in the coat right n\u2014 Gary is"
        isContradiction: 1
        callOutResponse: ...Fine. We are three raccoons. But we are VERY good at
