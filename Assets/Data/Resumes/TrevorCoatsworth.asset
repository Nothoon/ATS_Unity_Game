    goodQuestion:
      question: Six foot two. Tall!
      answer: Yes. Very tall. Very stable. Mostly.
      demeanor: 2
      phrases: []
  - id: ref
    text: Gary Coatsworth (not related)
    isSuspicious: 1
    category: 5
    designerNote: 'Same surname: Gary is the middle raccoon.'
    suspiciousQuestion:
      question: Gary Coatsworth has the same last name. Are you related?
      answer: No. Coatsworth is a very common name for {g_coats}.
      demeanor: 5
      phrases:
