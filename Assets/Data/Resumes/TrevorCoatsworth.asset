  claims:
  - id: exp
    text: Grand Plaza Dumpster Area
    isSuspicious: 0
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: You supervised a... dumpster area?
      answer: Yes. I {t_organized}. Very clean. No one ever ate out of it. {t_except}.
      demeanor: 1
      phrases:
      - id: t_organized
        text: organized it
        isContradiction: 0
        callOutResponse: Organized by smell. Very efficient system.
        callOutDemeanor: 1
      - id: t_except
        text: Except for me
        isContradiction: 1
        callOutResponse: I mean NO ONE. No one eats from it. Especially not three
          small... I mean ONE normal man.
        callOutDemeanor: 3
    goodQuestion:
      question: Night supervisor! Reliable work.
      answer: I love the night. I am most awake at night. For normal human reasons.
      demeanor: 1
      phrases: []
  - id: dates
    text: Mar 2021 - Present
    isSuspicious: 0
    category: 1
    designerNote: 
    suspiciousQuestion:
      question: Five years at the dumpster. Why leave?
      answer: They {d_lid}. Very disrespectful.
      demeanor: 4
      phrases:
      - id: d_lid
        text: put a lock on the lid
        isContradiction: 0
        callOutResponse: We... I mean I... will not discuss the lock.
        callOutDemeanor: 4
    goodQuestion:
      question: Five years! Very loyal.
      answer: "Very loyal. We\u2014 I always come back. Every night. Without fail."
      demeanor: 2
      phrases: []
  - id: skill_trash
    text: Waste management (hands-on)
    isSuspicious: 0
    category: 4
    designerNote: 
