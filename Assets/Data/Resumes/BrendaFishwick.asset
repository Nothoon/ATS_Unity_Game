  m_Script: {fileID: 11500000, guid: e1ca3afc4caf41b1b42aa68d0b30a0a2, type: 3}
  m_Name: BrendaFishwick
  m_EditorClassIdentifier: Assembly-CSharp::ResumeData
  applicantName: Brenda Fishwick
  body: '<b>BRENDA FISHWICK</b>

    Applying for: Office Manager


    <b>EXPERIENCE</b>

    {title}
    - Dunwell Paper Co.

    {dates}

    Managed an office of {office_size}


    <b>CERTIFICATIONS</b>

    {cert}


    <b>SKILLS</b>

    Scheduling,
    {skill_fridge}


    <b>REFERENCES</b>

    {ref}'
  claims:
  - id: title
    text: Supreme Office Overlord
    isSuspicious: 1
    category: 2
    designerNote: Breaks rule 5 on paper, but it's a joke title. She's an honest,
      great hire.
    suspiciousQuestion:
      question: '''Supreme Office Overlord''? With three years of experience?'
      answer: Oh dear. That's {o_nickname}. My official title is {o_official}. I
        should have fixed that.
      demeanor: 2
      phrases:
      - id: o_nickname
        text: what my coworkers called me
        isContradiction: 0
        callOutResponse: After I organized the supply closet by color, they started
          bowing when I walked in. It got out of hand.
        callOutDemeanor: 2
      - id: o_official
        text: Office Coordinator
        isContradiction: 0
        callOutResponse: I can show you my pay stub. It says Coordinator. In very
          small font.
        callOutDemeanor: 2
    goodQuestion:
      question: Supreme Office Overlord sounds powerful.
      answer: It's a long story involving a label maker. I regret nothing.
      demeanor: 1
      phrases: []
  - id: dates
    text: Jun 2023 - Present
    isSuspicious: 0
    category: 1
    designerNote: 
    suspiciousQuestion:
      question: Are these dates accurate?
      answer: To the day. I have a {d_cal} for everything.
      demeanor: 1
      phrases:
      - id: d_cal
        text: color-coded calendar
        isContradiction: 0
        callOutResponse: It's color-coded by mood. Today is teal.
        callOutDemeanor: 1
    goodQuestion:
      question: Three years at Dunwell. How was it?
      answer: Lovely. Except for the paper cuts. So many paper cuts.
      demeanor: 0
      phrases: []
  - id: office_size
    text: 40 people (and one ghost)
    isSuspicious: 0
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: ...One ghost?
      answer: Gerald. He {g_stapler}. We came to an understanding.
      demeanor: 1
      phrases:
      - id: g_stapler
        text: kept stealing the staplers
        isContradiction: 0
        callOutResponse: I bought him his own stapler. Problem solved. Ghosts just
          want to feel included.
        callOutDemeanor: 1
    goodQuestion:
      question: Managing 40 people is a lot.
      answer: 41, counting Gerald. But he's very low maintenance.
      demeanor: 1
      phrases: []
  - id: cert
    text: 'Certified Spreadsheet Wizard (ID: XL-4420)'
    isSuspicious: 0
    category: 3
    designerNote: 
    suspiciousQuestion:
      question: Is that certification real?
      answer: Yes, the ID is XL-4420. The exam was {c_hard}.
      demeanor: 1
      phrases:
      - id: c_hard
        text: four hours of pivot tables
        isContradiction: 0
        callOutResponse: Four hours. Two people fainted. I did not.
        callOutDemeanor: 1
    goodQuestion:
      question: Spreadsheet Wizard! What's your favorite formula?
      answer: VLOOKUP. Don't tell XLOOKUP.
      demeanor: 1
      phrases: []
  - id: skill_fridge
    text: Fridge Diplomacy
    isSuspicious: 0
    category: 4
    designerNote: 
    suspiciousQuestion:
      question: What is 'Fridge Diplomacy'?
      answer: Negotiating whose yogurt is whose. I once {f_peace}.
      demeanor: 1
      phrases:
      - id: f_peace
        text: ended a six-month lunch war
        isContradiction: 0
        callOutResponse: There were sticky notes. There were threats. Now there is
          a labelled shelf system, and peace.
        callOutDemeanor: 1
    goodQuestion:
      question: We need Fridge Diplomacy. Badly.
      answer: I can tell. I smelled your break room from the lobby.
      demeanor: 1
      phrases: []
  - id: ref
    text: Harold Dunwell, owner of Dunwell Paper Co.
    isSuspicious: 0
    category: 5
    designerNote: 
    suspiciousQuestion:
      question: Is Harold Dunwell related to you?
      answer: No! He's my boss. He's {h_age} and still comes in every day.
      demeanor: 0
      phrases:
      - id: h_age
        text: 92
        isContradiction: 0
        callOutResponse: He says paper keeps him young. He may be right.
        callOutDemeanor: 0
    goodQuestion:
      question: Will Harold vouch for you?
      answer: He wrote me a letter. On very nice paper. He insisted.
      demeanor: 1
      phrases: []
  referenceLetter: 'To whom it may concern,


    Brenda ran my paper company''s
    office for {rl_years}. She {rl_fridge}, which no one before her managed.


    I
