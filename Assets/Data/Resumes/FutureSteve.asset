      answer: 
      demeanor: 0
      phrases: []
    goodQuestion:
      question: 
      answer: 
      demeanor: 0
      phrases: []
  - id: rl_recommend
    text: without reservation, and also buy umbrellas
    isSuspicious: 1
    category: 5
    designerNote: Odd advice.
    suspiciousQuestion:
      question: 
      answer: 
      demeanor: 0
      phrases: []
    goodQuestion:
      question: 
      answer: 
      demeanor: 0
      phrases: []
  referenceCheckTranscript: '<b>Steve (older):</b> Hello. {rc_voice}.


    <b>You:</b>
    You sound exactly like Steve.


    <b>Steve (older):</b> {rc_family}. He''s
    going to do great. Don''t ask me about the lottery.'
  referenceCheckClaims:
  - id: rc_voice
    text: It's me. Well, you know, older me
    isSuspicious: 1
    category: 5
    designerNote: Admits it's the same person.
    suspiciousQuestion:
      question: 
      answer: 
      demeanor: 0
      phrases: []
    goodQuestion:
      question: 
      answer: 
      demeanor: 0
      phrases: []
