    {ref}'
  claims:
  - id: title
    text: "Founder of the Hustle Mindset Movement\u2122"
    isSuspicious: 1
    category: 2
    designerNote: 
    suspiciousQuestion:
      question: What is the 'Hustle Mindset Movement'?
      answer: It's a lifestyle. We wake up at {h_3am} and drink raw eggs and ambition.
      demeanor: 1
      phrases:
      - id: h_3am
        text: 3 AM
        isContradiction: 0
        callOutResponse: Sleep is for people with no followers.
        callOutDemeanor: 1
    goodQuestion:
      question: A founder! Nice.
      answer: Founder, CEO, and only member. But the energy is huge.
      demeanor: 1
      phrases: []
  - id: followers
    text: 12 million followers
    isSuspicious: 1
    category: 0
    designerNote: Bought followers. Rule 8 says confirm it in the interview.
    suspiciousQuestion:
      question: 12 million followers. Can you prove that?
      answer: "Easy. Every one of them is {f_real}. I bought\u2014 I mean, I {f_earned}
        them."
      demeanor: 1
      phrases:
      - id: f_real
        text: real and engaged
        isContradiction: 0
        callOutResponse: Very engaged. They comment 'nice pic' on everything. Even
          my tax documents.
        callOutDemeanor: 1
      - id: f_earned
        text: earned
        isContradiction: 1
        callOutResponse: ...Fine, I bought them. $49.99 for 12 million. Honestly,
          that's a great deal. You should get some.
        callOutDemeanor: 3
    goodQuestion:
      question: 12 million! Impressive reach.
      answer: Massive reach. Mostly in a country I can't find on a map. Huge fans,
        though.
      demeanor: 1
      phrases: []
  - id: viral
    text: Went viral for eating a lightbulb
    isSuspicious: 1
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: You went viral for... eating a lightbulb?
      answer: '{v_part}. It was a small lightbulb. I''m fine now. Mostly.'
      demeanor: 4
      phrases:
      - id: v_part
        text: Part of a lightbulb
        isContradiction: 0
        callOutResponse: The glowy part. Look, the views were incredible.
        callOutDemeanor: 4
    goodQuestion:
      question: Going viral is valuable.
      answer: So valuable. My doctor said never again, but the views said yes.
      demeanor: 1
      phrases: []
  - id: skill_grind
    text: 24/7 grindset
    isSuspicious: 0
    category: 4
    designerNote: 
    suspiciousQuestion:
      question: '''24/7 grindset''? When do you sleep?'
      answer: I don't. I {g_sleep}.
      demeanor: 1
      phrases:
      - id: g_sleep
        text: nap in the shower
        isContradiction: 0
        callOutResponse: Two minutes. Standing up. It's the hustle.
        callOutDemeanor: 1
    goodQuestion:
      question: A hard worker. Great.
      answer: The hardest. I once grinded so hard I forgot my own birthday. My followers
        didn't remember it either.
      demeanor: 0
      phrases: []
  - id: ref
    text: '@HustleBot_9000'
    isSuspicious: 1
    category: 5
    designerNote: 
    suspiciousQuestion:
      question: Your reference is '@HustleBot_9000'?
      answer: He's my business partner. A very real person who {b_posts}.
      demeanor: 2
      phrases:
      - id: b_posts
        text: posts every four seconds
        isContradiction: 1
        callOutResponse: ...Okay, he's a bot. But he's MY bot. And he's very supportive.
        callOutDemeanor: 3
    goodQuestion:
      question: Can HustleBot vouch for you?
      answer: He'll say 'Great post! Check my profile for crypto tips!' That's a
        yes.
      demeanor: 1
      phrases: []
