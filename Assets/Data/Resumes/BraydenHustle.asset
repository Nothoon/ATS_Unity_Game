  body: '<b>BRAYDEN "BRAND" HUSTLE</b>

    Applying for: Social Media Manager


    <b>EXPERIENCE</b>

    {title}


    <b>STATS</b>

    {followers}

    {viral}


    <b>SKILLS</b>

    {skill_grind}


