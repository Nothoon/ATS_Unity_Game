  m_Script: {fileID: 11500000, guid: e1ca3afc4caf41b1b42aa68d0b30a0a2, type: 3}
  m_Name: ReginaldPompington
  m_EditorClassIdentifier: Assembly-CSharp::ResumeData
  applicantName: Sir Reginald Pompington III
  body: '<b>SIR REGINALD POMPINGTON III</b>

    Applying for: Social Media Manager
    (Lord of)


    <b>TITLES</b>

    {knight}


    <b>EXPERIENCE</b>

    {title}

    {dates}


    <b>SKILLS</b>

    {skill_internet}


    <b>REFERENCES</b>

    {ref}'
  claims:
  - id: knight
    text: Knighted by the Queen (of Social Media)
    isSuspicious: 1
    category: 0
    designerNote: 
    suspiciousQuestion:
      question: Who is the 'Queen of Social Media'?
      answer: A very important woman. She {q_followers}. She knighted me with a selfie
        stick.
      demeanor: 4
      phrases:
      - id: q_followers
        text: has 900 followers
        isContradiction: 0
        callOutResponse: 900 LOYAL followers. Quality over quantity, peasant.
        callOutDemeanor: 4
    goodQuestion:
      question: A knighthood! Very distinguished.
      answer: Indeed. You may kiss my ring. It's from a vending machine, but it is
        still a ring.
      demeanor: 1
      phrases: []
  - id: title
    text: Grand Duke of Hashtags
    isSuspicious: 1
    category: 2
    designerNote: Fancy title with one year of experience breaks rule 5.
    suspiciousQuestion:
      question: '''Grand Duke of Hashtags''? How many years of experience?'
      answer: '{d_years}. Social media years count double. Like dog years.'
      demeanor: 4
      phrases:
      - id: d_years
        text: Three
        isContradiction: 1
        callOutResponse: ...One. It's one year. But it FELT like three. Very tiring
          work, hashtags.
        callOutDemeanor: 4
    goodQuestion:
      question: Grand Duke! A strong title.
      answer: I gave it to myself. Nobody else would. Their loss.
      demeanor: 1
      phrases: []
  - id: dates
    text: 2025 - Present
    isSuspicious: 0
    category: 1
    designerNote: 
    suspiciousQuestion:
      question: Where have you worked since 2025?
      answer: At my {m_manor}.
      demeanor: 4
      phrases:
      - id: m_manor
        text: manor
        isContradiction: 1
        callOutResponse: Fine, it's my mother's basement. But I call it the manor,
          and so should you.
        callOutDemeanor: 4
    goodQuestion:
      question: Recent experience. Good.
      answer: Very recent. Practically fresh. Like a scone.
      demeanor: 1
      phrases: []
  - id: skill_internet
    text: Fluent in Internet
    isSuspicious: 0
    category: 4
    designerNote: 
    suspiciousQuestion:
      question: What does 'fluent in Internet' mean?
      answer: 'I speak fluent meme. For example: {i_lol}.'
      demeanor: 1
      phrases:
      - id: i_lol
        text: '''lol'''
        isContradiction: 0
        callOutResponse: Also 'rofl'. And 'yeet'. I am extremely current.
        callOutDemeanor: 1
    goodQuestion:
      question: Internet fluency is essential.
      answer: I've been online since the year 2000. I've seen things. Terrible, hilarious
        things.
      demeanor: 1
      phrases: []
  - id: ref
    text: His Lordship, the Grand Duke of Hashtags (also me)
    isSuspicious: 1
    category: 5
    designerNote: 
    suspiciousQuestion:
      question: Your reference is... also you?
      answer: Who better to judge greatness than greatness itself?
      demeanor: 1
      phrases: []
    goodQuestion:
      question: Your reference speaks highly of you, I'm sure.
      answer: He adores me. We have breakfast together every morning. In the mirror.
      demeanor: 1
      phrases: []
  referenceLetter: 'Hear ye, hear ye,


    It is my great honour to recommend Sir
    Reginald Pompington III. He is {rl_greatness}. He {rl_knight}.


    Signed,

    His
    Lordship, the Grand Duke of Hashtags

    (also Sir Reginald Pompington III)'
