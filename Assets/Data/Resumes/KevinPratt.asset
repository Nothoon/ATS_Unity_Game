  referenceCheckTranscript: '<b>Dr. Pratt:</b> Dr. Pratt speaking. Oh, you want my
    reference? {rc_oh}.


    <b>You:</b> You are the reference.


    <b>Dr. Pratt:</b>
    {rc_other}. Hello, I''m Dr. Pratt''s former colleague, Dr. Pratt. He is a marvel.'
  referenceCheckClaims:
  - id: rc_oh
    text: One moment, let me put on my other voice
    isSuspicious: 1
    category: 5
